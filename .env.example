# 数据源模式：mock（默认）或 http
VITE_API_MODE=mock
# http 模式下后端 API 根地址（例如 http://localhost:8989）
VITE_API_BASE_URL=http://localhost:8989
# Optional convenience only. Do not add a password to frontend environment files.
VITE_DEFAULT_LOGIN_ACCOUNT=
# HTTP 登录客户端；与后端账号 JSON 的 clients 键一致。
# 留空沿用 admin-web；切换客户端/类型后需重启前端并重新登录。
VITE_AUTH_CLIENT_ID=
# 可选用户类型；留空使用该客户端的 defaultUserType。
VITE_AUTH_USER_TYPE=
